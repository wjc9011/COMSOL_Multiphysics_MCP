msgid "Internal settings format name. You do not need to change it."
msgstr "设置文件内部使用的格式名称，不需要修改。"

msgid "Settings format version used when this file is saved."
msgstr "保存文件时使用的设置格式版本。"

msgid "Language used by this Settings window."
msgstr "此设置窗口使用的语言。"

msgid "Size of text and controls. Following system display settings is recommended. Other choices are previewed immediately and saved for the next opening."
msgstr "文字和控件的大小。建议跟随系统显示设置。其他选项会立即预览，并在下次打开时继续使用。"

msgid "Follow system display settings"
msgstr "跟随系统显示设置"

msgid "Experimental Linux: offline tools only. COMSOL execution is disabled. Semantic search is not accepted."
msgstr "Linux 为实验性支持，仅提供离线工具。COMSOL 执行已禁用。语义搜索尚未通过验收。"

msgid "Safety-first default for new users. It offers fewer operations, which lowers the risk of an unintended change. Choose it while learning or when you only need to open and inspect models, manage jobs, run careful single-point checks, or search manuals."
msgstr "面向新手的安全默认选项。它提供的操作较少，可降低误操作风险。学习阶段，或只需要打开和查看模型、管理任务、进行谨慎的单点检查或搜索手册时，请选择此项。"

msgid "Recommended for most users. It covers ordinary FEM model building and result export, and includes tools for making a Windows standalone package. Choose it for general simulation work that does not need a specialist profile."
msgstr "推荐大多数用户选择。它覆盖常规 FEM 建模和结果导出，也包含制作 Windows standalone 包的工具。一般仿真不需要专用 profile 时，请选择此项。"

msgid "For optical and metasurface work. Adds materials, field review, Wave Optics checks, point audits, and staged parameter workflows to Core."
msgstr "适合光学和超表面工作。在 Core 基础上增加材料、场结果查看、Wave Optics 检查、单点审计和分阶段参数流程。"

msgid "Isolated Electrochemistry Module profile. Adds electrochemistry discovery, interface creation, electrode reaction, and electrolyte tools to Core. These tools are not available in the default or Full profiles."
msgstr "隔离的电化学模块 profile。在 Core 基础上增加电化学发现、接口创建、电极反应和电解质工具。这些工具在默认或 Full profile 中不可用。"

msgid "For testing extra helpers that are broader or less mature. Use it only when a required tool is missing from the safer profiles, and check every output carefully."
msgstr "适合测试范围更广或尚未成熟的额外工具。只有在较安全的 profile 缺少所需工具时才使用，并仔细检查每项输出。"

msgid "For old workflows that need nearly every tool. It keeps older broad path behavior and has weaker file containment. New users should not choose it."
msgstr "适合需要几乎全部工具的旧流程。它保留较宽松的旧路径行为，文件范围保护较弱；新用户不应选择。"

msgid "Offline model inspection for computers without COMSOL. Only solver-free read-only inspection tools are available; nothing here can start COMSOL or Java."
msgstr "面向未安装 COMSOL 的计算机的离线模型检查。仅提供求解器无关的只读检查工具；此处任何功能都不会启动 COMSOL 或 Java。"

msgid "Folder for working files and locks. Use an ASCII-only path. \nExample: %PROGRAMDATA%\\comsol_mcp\\runtime"
msgstr "存放运行文件和锁的文件夹。路径只能含 ASCII 字符。\n示例：%PROGRAMDATA%\\comsol_mcp\\runtime"

msgid "Optional separate folder for resumable jobs. Leave it empty to use the runtime folder. \nExample: %PROGRAMDATA%\\comsol_mcp\\runtime\\jobs"
msgstr "可选的可恢复任务文件夹。留空时使用运行目录。\n示例：%PROGRAMDATA%\\comsol_mcp\\runtime\\jobs"

msgid "Folders where COMSOL MCP may read your .mph files. Chinese paths are supported. \nExample: %LOCALAPPDATA%\\comsol_mcp\\models"
msgstr "COMSOL MCP 可以读取 .mph 文件的文件夹。支持中文路径。\n示例：%LOCALAPPDATA%\\comsol_mcp\\models"

msgid "Folder where COMSOL MCP writes results and evidence. Use an ASCII-only path. \nExample: %PROGRAMDATA%\\comsol_mcp\\artifacts"
msgstr "COMSOL MCP 写入结果和证据的文件夹。路径只能含 ASCII 字符。\n示例：%PROGRAMDATA%\\comsol_mcp\\artifacts"

msgid "Folder where COMSOL Multiphysics 6.4 is installed. \nExample: C:\\COMSOL64\\Multiphysics"
msgstr "COMSOL Multiphysics 6.4 的安装文件夹。\n示例：C:\\COMSOL64\\Multiphysics"

msgid "Java folder used by COMSOL. Auto-detect can fill this value. \nExample: C:\\COMSOL64\\Multiphysics\\java\\win64\\jre"
msgstr "COMSOL 使用的 Java 文件夹，可由自动检测填写。\n示例：C:\\COMSOL64\\Multiphysics\\java\\win64\\jre"

msgid "JDK folder used by COMSOL. Auto-detect can fill this value. \nExample: C:\\COMSOL64\\Multiphysics\\java\\win64\\jre"
msgstr "COMSOL 使用的 JDK 文件夹，可由自动检测填写。\n示例：C:\\COMSOL64\\Multiphysics\\java\\win64\\jre"

msgid "Enable optional interactive collaboration with a COMSOL Desktop connected to a local Server. This feature composes with every tool profile."
msgstr "启用与连接到本机 Server 的 COMSOL Desktop 的可选交互协作。此功能可与任意工具 profile 组合使用。"

msgid "Experimental progressive tool-schema delivery. It is off by default and only changes discovery pagination; it does not enable tools or change permissions."
msgstr "实验性的渐进式工具 schema 下发。此开关默认关闭，仅改变 discovery 分页方式；不会启用任何工具，也不会改变权限。"

msgid "Enable the COMSOL Model Manager tools for the selected profile. This is a separate optional feature and stays off unless you enable it here."
msgstr "为所选工具 profile 启用 COMSOL Model Manager 工具。这是一个独立的可选功能，只有在启用后才会开启。"

msgid "Allow saving a derived copy back to the COMSOL Model Manager. This is separate from shared Desktop collaboration. Opening, running, and downloading models work without it."
msgstr "允许把派生副本保存回 COMSOL Model Manager。此开关独立于共享 Desktop 协作。未开启时仍可打开、运行和下载模型。"

msgid "Check that execution results and scientific conclusions are reported separately."
msgstr "检查运行结果和科学结论是否分开说明。"

msgid "Check saved result files and their hashes."
msgstr "检查保存的结果文件及其哈希。"

msgid "Check that summary statements match the saved result values."
msgstr "检查摘要说明是否与保存的结果数值一致。"

msgid "Check that a resumed job uses the same producer and driver."
msgstr "检查恢复任务是否使用相同的生成器和驱动。"

msgid "Manual sources and lexical search"
msgstr "手册来源与词法搜索"

msgid "Optional semantic search"
msgstr "可选语义搜索"

msgid "Enable local keyword search for installed or copied PDF manuals. This is off by default because COMSOL manuals may not be installed."
msgstr "启用已安装或复制到本机的 PDF 手册关键词搜索。由于安装 COMSOL 时可能未安装手册，此功能默认关闭。"

msgid "Folder scanned recursively when generating the manual index. Choose the folder containing the PDF manuals."
msgstr "生成手册索引时递归扫描的文件夹。请选择包含 PDF 手册的文件夹。"

msgid "SQLite FTS5/BM25 index used by manual_search. Enter an ASCII-only SQLite file or destination folder. A folder uses lexical_manuals.sqlite3."
msgstr "manual_search 使用的 SQLite FTS5/BM25 索引。请输入仅含 ASCII 字符的 SQLite 文件或目标文件夹；文件夹会使用 lexical_manuals.sqlite3。"

msgid "Enable optional semantic manual-search tools for the selected profile. This feature requires prepared local indexes and a search model."
msgstr "为所选 profile 启用可选的语义手册搜索工具。此功能需要预先准备本地索引和搜索模型。"

msgid "Optional folder containing the prepared semantic vector index. It is independent from the SQLite lexical index."
msgstr "存放已准备语义向量索引的可选文件夹。它与 SQLite 词法索引相互独立。"

msgid "Optional folder containing the local semantic-search model. \nExample: %LOCALAPPDATA%\\comsol_mcp\\semantic\\models"
msgstr "存放本地语义搜索模型的可选文件夹。\n示例：%LOCALAPPDATA%\\comsol_mcp\\semantic\\models"

msgid "Optional name that identifies who owns the COMSOL session."
msgstr "用于说明谁在使用 COMSOL 会话的可选名称。"

msgid "Enter a valid absolute path or clear this setting."
msgstr "请输入有效的绝对路径，或清空此项。"

msgid "Enter an ASCII-only full path, or leave this setting empty."
msgstr "请输入仅含 ASCII 字符的完整路径，或将此项留空。"

msgid "Enter a valid absolute path."
msgstr "请输入有效的绝对路径。"

msgid "Enter a valid value for this setting."
msgstr "请输入此设置允许的有效值。"

msgid "Required setting is missing."
msgstr "缺少必需设置。"

msgid "Unknown setting is not supported."
msgstr "不支持未知设置。"

msgid "Disable evidence check?"
msgstr "要禁用证据检查吗？"

msgid "Disabling an evidence check makes future results not fully verified. Continue?"
msgstr "禁用证据检查后，后续结果将不再是完整核验状态。是否继续？"

msgid "Restart required"
msgstr "需要重启"

msgid "Invalid settings"
msgstr "设置无效"

msgid "Correct every highlighted field before saving."
msgstr "请先修正所有标红字段，再保存。"

msgid "Save failed"
msgstr "保存失败"

msgid "Settings were not saved. Close conflicting editors and try again."
msgstr "设置未保存。请关闭冲突的编辑器后重试。"

msgid "Discard changes?"
msgstr "要放弃改动吗？"

msgid "Close without saving the current edits?"
msgstr "是否放弃当前编辑并关闭窗口？"

msgid "The configured COMSOL root is not a supported 6.4 installation."
msgstr "当前 COMSOL 根目录不是受支持的 6.4 安装。"

msgid "Multiple COMSOL 6.4 installations were found. Choose one manually."
msgstr "检测到多个 COMSOL 6.4 安装，请手动选择。"

msgid "No supported COMSOL 6.4 installation was found."
msgstr "未找到受支持的 COMSOL 6.4 安装。"

msgid "Replace existing values?"
msgstr "要替换现有值吗？"

msgid "Auto-detect would replace these settings: {keys}"
msgstr "自动检测将替换这些设置：{keys}"

msgid "Settings conflict"
msgstr "设置冲突"

msgid "The settings file changed outside this editor. Close this window and reopen settings."
msgstr "设置文件已被其他程序修改。请关闭此窗口并重新打开设置。"

msgid "The selected language catalog is unavailable; English is active."
msgstr "所选语言资源不可用，当前已切换为英文。"

msgid "No writable settings file exists. Rebuild canonical settings now?\n\nChoose No to exit without writing."
msgstr "尚无可写的设置文件。现在创建标准设置吗？\n\n选择“否”将直接退出且不写入文件。"

msgid "Another settings editor is active. Close it and reopen settings."
msgstr "另一个设置编辑器正在运行。请先关闭它，再重新打开设置。"

msgid "Settings could not be prepared safely."
msgstr "无法安全地准备设置文件。"

msgid "Settings are missing or damaged. Preserve them and rebuild defaults?"
msgstr "设置文件缺失或已损坏。是否保留原文件并重建默认设置？"

msgid "Generate Index"
msgstr "生成索引"

msgid "Generate manual index"
msgstr "生成手册索引"

msgid "Starting index worker..."
msgstr "正在启动索引工作进程……"

msgid "Cancelling safely..."
msgstr "正在安全取消……"

msgid "{percent}% — {files}/{total_files} PDF(s), {pages}/{total_pages} page(s){source}"
msgstr "{percent}% — {files}/{total_files} 个 PDF，{pages}/{total_pages} 页{source}"

msgid "Replace existing index?"
msgstr "要替换现有索引吗？"

msgid "A validated new index will atomically replace the existing file. Continue?"
msgstr "验证通过的新索引将原子替换现有文件。是否继续？"

msgid "Choose both the PDF folder and SQLite index file first."
msgstr "请先同时选择 PDF 文件夹和 SQLite 索引文件。"

msgid "Index generation could not start. Check the selected paths and permissions."
msgstr "无法启动索引生成。请检查所选路径和权限。"

msgid "Manual index ready"
msgstr "手册索引已就绪"

msgid "Indexed {pdfs} PDF(s) and {pages} page(s). Corpus fingerprint: {fingerprint}"
msgstr "已索引 {pdfs} 个 PDF、{pages} 页。语料指纹：{fingerprint}"

msgid "Index generation failed"
msgstr "索引生成失败"

msgid "The index worker stopped without a completion receipt."
msgstr "索引工作进程已停止，但未返回完成凭据。"

msgid "Index generation cancelled"
msgstr "已取消索引生成"

msgid "Temporary files were removed and the previous index was preserved."
msgstr "临时文件已清理，原有索引保持不变。"

msgid "Manual search is not ready"
msgstr "手册搜索尚未就绪"

msgid "Choose or generate a valid SQLite manual index before enabling search."
msgstr "请先选择或生成有效的 SQLite 手册索引，再启用搜索。"

msgid "Semantic search is not ready"
msgstr "语义搜索尚未就绪"

msgid "Enable manual search and choose valid lexical, semantic-index, and model assets first."
msgstr "请先启用手册搜索，并选择有效的词法索引、语义索引和模型资源。"

msgid "Application launcher"
msgstr "应用启动器"

msgid "Create application launcher"
msgstr "创建应用启动器"

msgid "Remove application launcher"
msgstr "移除应用启动器"

msgid "Replace existing application launcher?"
msgstr "要替换现有应用启动器吗？"

msgid "Application launcher ready"
msgstr "应用启动器已就绪"

msgid "The application launcher now opens this exact settings file."
msgstr "此应用启动器现在会打开当前这一设置文件。"

msgid "Application launcher could not be created"
msgstr "无法创建应用启动器"

msgid "Application launcher removed"
msgstr "应用启动器已移除"

