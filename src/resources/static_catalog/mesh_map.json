{
 "knowledge": {
  "adapt": {
   "exprtype": "error (expression-based) | size (size field) | metric (anisotropic metric -> forces method=modify)",
   "method": "regular (r>1 only) | modify",
   "decision_props": [
    "errorexpr",
    "horder",
    "maxrefinement",
    "elselect: globalmin|worstpar|elementspar (element selection for refinement)",
    "solution (ref)",
    "reevaluate",
    "updatecondition"
   ],
   "note": "error type requires solution data; errorexpr -> lib prop adapedim; identical-until computed via MeshIdentical.computeIdenticalUntil"
  },
  "boundary_layer": {
   "method": "latest | legacy",
   "geom_props": [
    "sharpcorners=split",
    "trimminangle/trimmaxangle",
    "splitangle",
    "splitdivangle",
    "layerdec (layer distribution)",
    "smoothtransition=on + smoothmaxiter/maxdepth",
    "thickness from Size sub-feature; stretch/numlayers on edge/corner levels"
   ],
   "note": "geometry-side healing is INTEGRAL (trim/split angles) - BLM builds geometry edit + mesh together; MeshControl geometry entities feed it"
  },
  "mesh_geom_mapping": {
   "mechanism": "MeshFinalize links mesh to geometric model via getGeometricModelMesh()/getGeom(); mesh sequences share geom by tag; Form Union entity numbering flows in; identical-mesh ops (MeshIdentical) reuse mesh on unchanged subtrees during rebuilds"
  },
  "generators": {
   "FreeTet/FreeTri/FreeQuad": "Delaunay-class (native csmesh.dll)",
   "Sweep/Map": "structured; take source face mesh + Distribution/Size along"
  }
 },
